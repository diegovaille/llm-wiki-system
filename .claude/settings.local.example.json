{
  "_comment": "Starter .claude/settings.local.json for developing wiki-system itself. Copy to .claude/settings.local.json and replace WIKI_SYSTEM_ROOT and WIKI_DATA_ROOT with absolute paths to your wiki-system repo and wiki data repo. This file is for editing wiki-system, NOT for consuming it in other projects — for that, see adapters/claude/install/install.md and run `wiki init`.",
  "permissions": {
    "allow": [
      "Bash(cd WIKI_SYSTEM_ROOT && *)",
      "Bash(.venv/bin/pytest*)",
      "Bash(.venv/bin/python*)",
      "Bash(.venv/bin/python3*)",
      "Bash(.venv/bin/wiki*)",
      "Bash(python -c *)",
      "Bash(python3 -c *)",
      "Bash(uv venv*)",
      "Bash(uv pip install*)",
      "Bash(uv pip list*)",
      "Bash(uv pip show*)",
      "Bash(uv sync*)",
      "Bash(uv lock*)",
      "Bash(uv run *)",
      "Bash(uv run python *)",
      "Bash(uv run python -c *)",
      "Bash(uv run python -m *)",
      "Bash(uv run pytest*)",
      "Bash(.venv/bin/python -c *)",
      "Bash(.venv/bin/python -m *)",
      "Bash(.venv/bin/python3 -c *)",
      "Bash(.venv/bin/python3 -m *)",
      "Bash(git init*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git status*)",
      "Bash(git ls-files*)",
      "Bash(git rev-parse*)",
      "Bash(git blame*)",
      "Bash(git cat-file*)",
      "Bash(git branch*)",
      "Bash(git config --get*)",
      "Bash(which *)",
      "Bash(test -*)",
      "Bash(mkdir -p WIKI_SYSTEM_ROOT/*)",
      "Bash(mkdir -p WIKI_DATA_ROOT/*)",
      "Read(WIKI_SYSTEM_ROOT/**)",
      "Read(WIKI_DATA_ROOT/**)",
      "Write(WIKI_SYSTEM_ROOT/**)",
      "Write(WIKI_DATA_ROOT/**)",
      "Edit(WIKI_SYSTEM_ROOT/**)",
      "Edit(WIKI_DATA_ROOT/**)",
      "Glob(WIKI_SYSTEM_ROOT/**)",
      "Glob(WIKI_DATA_ROOT/**)",
      "Grep(WIKI_SYSTEM_ROOT/**)",
      "Grep(WIKI_DATA_ROOT/**)"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git rebase*)",
      "Bash(git branch -D*)",
      "Bash(rm -rf*)"
    ]
  }
}
